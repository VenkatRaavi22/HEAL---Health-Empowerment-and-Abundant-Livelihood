# ─────────────────────────────────────────────────────────────────────────────
# HEAL Frontend Environment Variables
# Rename this file to .env and fill in your Firebase project credentials.
#
# HOW TO GET THESE VALUES:
#   1. Go to https://console.firebase.google.com
#   2. Open your project → Project Settings → Your apps → Web app
#   3. Copy each value from the firebaseConfig object shown there
# ─────────────────────────────────────────────────────────────────────────────

VITE_FIREBASE_API_KEY=your-api-key-here
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
VITE_FIREBASE_APP_ID=your-app-id
